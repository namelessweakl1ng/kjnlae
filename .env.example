# Development only. Production requires a randomly generated >=32-character API key.
KJNLAE_ENV=development
KJNLAE_API_KEY=
KJNLAE_RATE_LIMIT=60
KJNLAE_ALLOWED_HOSTS=localhost,127.0.0.1
KJNLAE_CORS_ORIGINS=
# Optional trusted server-side policy; never accept this from an agent/request.
# Optional explicit artifact override. Run `kjnlae model download` for the per-user default.
KJNLAE_MODEL_DIR=
KJNLAE_MODEL_HASH=
# Docker Compose host path to verified local artifact.
KJNLAE_MODEL_DIR_HOST=./var/models/reviewed-v0.2
# Optional trusted host-owned v2 authority JSON, mode 0600 in production.
KJNLAE_AUTHORITY_V2_FILE=
# Exact allowed output link hosts, comma-separated. Empty denies external links.
KJNLAE_OUTPUT_HOSTS=
# JSON array of known secrets. Set securely; never commit real values.
KJNLAE_OUTPUT_SECRETS_JSON=[]
